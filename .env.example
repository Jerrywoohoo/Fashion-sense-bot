# ==========================================
# Telegram Bot Configuration
# ==========================================
# Bot token issued by @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ==========================================
# AWS Bedrock Credentials (Vision & Stylist)
# ==========================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN is required only if using temporary session credentials (e.g. AWS SSO / Learner Lab)
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# ==========================================
# Database & Storage Settings (Optional)
# ==========================================
# Path to SQLite database file (defaults to data/wardrobe.db)
DATABASE_PATH=data/wardrobe.db

# ==========================================
# Demo & Evaluation Settings (Optional)
# ==========================================
# Optional password for judges to access pre-seeded wardrobe in pool mode via /admintest
ADMIN_TEST_PASSWORD=demo123
ADMIN_TELEGRAM_USER_ID=
